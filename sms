STUDENT_FILE = "students.txt"
ATTENDANCE_FILE = "attendance.txt"
RESULT_FILE = "results.txt"

# ---------------- STUDENT MANAGEMENT ----------------

def add_student():
    print("\n--- ADD STUDENT ---")
    roll = input("Enter roll number: ").strip()
    name = input("Enter student name: ").strip()
    course = input("Enter course: ").strip()
    age = input("Enter age: ").strip()

    if roll == "" or name == "" or course == "":
        print("Error: All fields are required.")
        return
    if not age.isdigit() or int(age) < 1 or int(age) > 100:
        print("Error: Enter a valid age.")
        return

    try:
        with open(STUDENT_FILE, "r") as file:
            for line in file:
                data = line.strip().split("|")
                if data[0] == roll:
                    print("Error: Roll number already exists.")
                    return
    except FileNotFoundError:
        pass

    with open(STUDENT_FILE, "a") as file:
        file.write(roll + "|" + name + "|" + course + "|" + age + "\n")
    print("Student added successfully.")


def view_students():
    print("\n--- ALL STUDENTS ---")
    try:
        with open(STUDENT_FILE, "r") as file:
            lines = file.readlines()
        if len(lines) == 0:
            print("No student records found.")
            return
        print("-" * 55)
        print("Roll No.\tName\t\tCourse\t\tAge")
        print("-" * 55)
        for line in lines:
            roll, name, course, age = line.strip().split("|")
            print(roll + "\t\t" + name + "\t\t" + course + "\t\t" + age)
        print("-" * 55)
    except FileNotFoundError:
        print("No student records found.")


def search_student():
    print("\n--- SEARCH STUDENT ---")
    roll = input("Enter roll number: ").strip()
    try:
        with open(STUDENT_FILE, "r") as file:
            for line in file:
                data = line.strip().split("|")
                if data[0] == roll:
                    print("\nStudent Found")
                    print("Roll Number :", data[0])
                    print("Name        :", data[1])
                    print("Course      :", data[2])
                    print("Age         :", data[3])
                    return
        print("Student not found.")
    except FileNotFoundError:
        print("No student records found.")


def update_student():
    print("\n--- UPDATE STUDENT ---")
    roll = input("Enter roll number to update: ").strip()
    try:
        with open(STUDENT_FILE, "r") as file:
            lines = file.readlines()
        found = False
        new_lines = []
        for line in lines:
            data = line.strip().split("|")
            if data[0] == roll:
                print("Enter new details:")
                name = input("New name: ").strip()
                course = input("New course: ").strip()
                age = input("New age: ").strip()
                if name == "" or course == "":
                    print("Invalid input. Update cancelled.")
                    return
                if not age.isdigit() or int(age) < 1 or int(age) > 100:
                    print("Invalid age. Update cancelled.")
                    return
                new_lines.append(roll + "|" + name + "|" + course + "|" + age + "\n")
                found = True
            else:
                new_lines.append(line)
        if found:
            with open(STUDENT_FILE, "w") as file:
                file.writelines(new_lines)
            print("Student updated successfully.")
        else:
            print("Student not found.")
    except FileNotFoundError:
        print("No student records found.")


def delete_student():
    print("\n--- DELETE STUDENT ---")
    roll = input("Enter roll number to delete: ").strip()
    try:
        with open(STUDENT_FILE, "r") as file:
            lines = file.readlines()
        new_lines = []
        found = False
        for line in lines:
            data = line.strip().split("|")
            if data[0] == roll:
                found = True
            else:
                new_lines.append(line)
        if found:
            with open(STUDENT_FILE, "w") as file:
                file.writelines(new_lines)
            print("Student deleted successfully.")
        else:
            print("Student not found.")
    except FileNotFoundError:
        print("No student records found.")

# ---------------- ATTENDANCE MANAGEMENT ----------------

def mark_attendance():
    print("\n--- MARK ATTENDANCE ---")
    roll = input("Enter roll number: ").strip()
    date = input("Enter date (DD-MM-YYYY): ").strip()
    status = input("Enter P for Present or A for Absent: ").strip().upper()
    if status != "P" and status != "A":
        print("Error: Enter only P or A.")
        return

    student_found = False
    try:
        with open(STUDENT_FILE, "r") as file:
            for line in file:
                data = line.strip().split("|")
                if data[0] == roll:
                    student_found = True
                    break
    except FileNotFoundError:
        pass

    if not student_found:
        print("Student not found. Add the student first.")
        return
    with open(ATTENDANCE_FILE, "a") as file:
        file.write(roll + "|" + date + "|" + status + "\n")
    print("Attendance saved successfully.")


def view_attendance():
    print("\n--- ATTENDANCE RECORDS ---")
    try:
        with open(ATTENDANCE_FILE, "r") as file:
            lines = file.readlines()
        if len(lines) == 0:
            print("No attendance records found.")
            return
        print("-" * 40)
        print("Roll No.\tDate\t\tStatus")
        print("-" * 40)
        for line in lines:
            roll, date, status = line.strip().split("|")
            print(roll + "\t\t" + date + "\t" + status)
        print("-" * 40)
    except FileNotFoundError:
        print("No attendance records found.")

# ---------------- RESULT MANAGEMENT ----------------

def add_result():
    print("\n--- ADD RESULT ---")
    roll = input("Enter roll number: ").strip()
    subject = input("Enter subject: ").strip()
    marks = input("Enter marks (0-100): ").strip()
    if subject == "":
        print("Error: Subject is required.")
        return
    if not marks.isdigit() or int(marks) < 0 or int(marks) > 100:
        print("Error: Marks must be between 0 and 100.")
        return

    student_found = False
    try:
        with open(STUDENT_FILE, "r") as file:
            for line in file:
                data = line.strip().split("|")
                if data[0] == roll:
                    student_found = True
                    break
    except FileNotFoundError:
        pass

    if not student_found:
        print("Student not found. Add the student first.")
        return
    with open(RESULT_FILE, "a") as file:
        file.write(roll + "|" + subject + "|" + marks + "\n")
    print("Result added successfully.")


def view_result():
    print("\n--- VIEW RESULT ---")
    roll = input("Enter roll number: ").strip()
    try:
        with open(RESULT_FILE, "r") as file:
            lines = file.readlines()
        found = False
        print("-" * 30)
        print("Subject\t\tMarks")
        print("-" * 30)
        for line in lines:
            r, subject, marks = line.strip().split("|")
            if r == roll:
                print(subject + "\t\t" + marks)
                found = True
        print("-" * 30)
        if not found:
            print("No result found for this student.")
    except FileNotFoundError:
        print("No result records found.")

